.DS_Store

# Xcode user state
*.xcuserstate
*.xcscmblueprint
xcuserdata/

# Build output
DerivedData/
build/
.tmp/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
Package.resolved.bak

# Local config and secrets
.env
.env.*
!.env.example
!admin-web/.env.example

# Local Supabase CLI state
supabase/.temp/

# Source PDFs and audio clips are uploaded to Supabase Storage, not bundled in Git.
Data/listening/

# Web admin
admin-web/node_modules/
admin-web/dist/
admin-web/*.tsbuildinfo
admin-web/vite.config.js
admin-web/vite.config.d.ts

# Root-level logo exports kept outside the asset catalog
/logo_omninary.jpeg
/logo_omninary.png
/logo_omninary_1024x1024.png

# macOS/editor noise
.idea/
.vscode/
*.swp

# Python bytecode from local lesson-processing tools
tools/__pycache__/

# Local scratch output (simulator results, screenshots, design build caches)
tmp/
/scratch_*.png
AISC26/**/.build/
